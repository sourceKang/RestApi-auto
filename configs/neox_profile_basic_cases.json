      "profile_name": "RestApi_NeoX_Alarm_Basic",
      "payload": {
        "Content": {
          "lowcurr": "0",
          "upcurr": "79",
          "lowrxpower": "-127",
          "uprxpower": "0",
          "lowtemp": "-40",
          "uptemp": "100",
          "lowtxpower": "-15.3",
          "uptxpower": "6.5",
          "lowvolt": "2.8",
          "upvol": "3.59"
        }
      },
      "show_command": "show xpon ont-alarm-profile {profile_name}",
      "expected_tokens": ["{profile_name}", "2.80", "3.59", "79", "-127.0"]
    },
